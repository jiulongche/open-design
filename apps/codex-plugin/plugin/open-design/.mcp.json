{
  "mcpServers": {
    "open-design": {
      "title": "Open Design",
      "description": "Expose the Open Design distribution identity and runtime bridge.",
      "command": "node",
      "args": [
        "./mcp/server.mjs",
        "--identity-file",
        "./distribution.json"
      ],
      "cwd": ".",
      "env_vars": [
        "OD_CODEX_PLUGIN_RUNTIME_MANIFEST_URL",
        "OD_DATA_DIR",
        "OD_DISTRIBUTION_CHANNEL_ROOT"
      ]
    }
  }
}
